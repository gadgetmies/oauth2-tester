{
  "compileOnSave": true,
  "compilerOptions": {
    "lib": [
      "es2017",
      "dom"
    ],
    "target": "es2017",
    "moduleResolution": "node",
    "skipLibCheck": true,
    "allowSyntheticDefaultImports": true,
    "outDir": "dist",
    "declaration": true,
    "declarationDir": "dist",
    "rootDir": "src"
  },
  "exclude": [
    "node_modules",
    "test",
    "dist"
  ]
}
